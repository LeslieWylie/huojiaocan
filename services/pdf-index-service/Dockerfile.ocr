FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PDF_INDEX_DATA_DIR=/data \
    PAGEINDEX_ADAPTER=fixture \
    OCR_PROVIDER=paddleocr \
    PADDLEOCR_LANGUAGE=ch \
    PADDLEOCR_MODEL=PP-OCRv6

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libglib2.0-0 libgomp1 libgl1 fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY app ./app

# PaddleOCR is deliberately isolated in this image. Native-text-only
# deployments do not download an OCR runtime, while scanned-page ingestion
# uses the official PaddleOCR CPU package rather than an LLM gateway.
RUN pip install --no-cache-dir . \
    && pip install --no-cache-dir \
       paddlepaddle==3.2.0 \
       -i https://www.paddlepaddle.org.cn/packages/stable/cpu/ \
    && pip install --no-cache-dir "paddleocr[all]==3.7.0"

RUN mkdir -p /data /opt/pageindex
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
