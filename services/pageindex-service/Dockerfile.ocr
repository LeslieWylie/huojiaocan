FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PDF_INDEX_DATA_DIR=/data \
    PAGEINDEX_ADAPTER=vendor \
    PAGEINDEX_VENDOR_ROOT=/app/pageindex_vendor/PageIndex \
    OCR_PROVIDER=paddleocr \
    PADDLEOCR_LANGUAGE=ch \
    PADDLEOCR_MODEL=PP-OCRv6

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libglib2.0-0 libgomp1 libgl1 fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir \
       paddlepaddle==3.2.0 \
       -i https://www.paddlepaddle.org.cn/packages/stable/cpu/ \
    && pip install --no-cache-dir "paddleocr[all]==3.7.0"

COPY app ./app
COPY pageindex ./pageindex
COPY pageindex_vendor ./pageindex_vendor
COPY seed-runtime ./seed-runtime

RUN mkdir -p /data
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
