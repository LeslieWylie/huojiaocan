# Server-side DeepSeek and data configuration. Never expose these values to the browser.
USER_DEEPSEEK_KEY_ENCRYPTION_SECRET=
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL=
LLM_TEXT_MODEL=
LLM_IMAGE_MODEL=
LLM_IMAGE_ENDPOINT=
LLM_GATEWAY_TIMEOUT_MS=120000
LLM_ANSWER_MODE=auto

# Document index provider: local | pageindex
DOCUMENT_INDEX_PROVIDER=local
PAGEINDEX_BASE_URL=
PAGEINDEX_API_KEY=
PAGEINDEX_TIMEOUT_MS=30000
PAGEINDEX_API_PREFIX=/internal/v1
ALLOW_INDEX_PROVIDER_FALLBACK=false

PORT=8787

# Immutable PDF upload storage. Required in production; never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Comma-separated accounts allowed to rebuild, correct, validate, or delete indexes.
# Ordinary teacher accounts can read public materials but cannot use maintenance writes.
INDEX_MAINTAINER_EMAILS=

# 仅供本地离线测试夹具使用；生产环境必须保持关闭或不设置。
ALLOW_ANONYMOUS_LOCAL_UPLOAD=false
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PUBLIC_BASE_URL=
PDF_UPLOAD_MAX_BYTES=
PDF_UPLOAD_LOCAL_DIR=
PDF_PUBLIC_BASE_URL=
# Maximum PDF size sent from the upload BFF to PageIndex /ingest inline.
# Larger files require a server-side object-storage pull worker.
PAGEINDEX_INLINE_INGEST_MAX_BYTES=25165824
