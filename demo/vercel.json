{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/*.js": { "maxDuration": 120 }
  },
  "rewrites": [
    { "source": "/materials/:file*", "destination": "/api/materials?file=:file*" },
    { "source": "/api/auth", "destination": "/api/config?auth=1" },
    { "source": "/api/index/:path*", "destination": "/api/index?path=:path*" },
    { "source": "/api/ai/:path*", "destination": "/api/ai?path=:path*" },
    { "source": "/api/drafts/:path*", "destination": "/api/drafts?path=:path*" },
    { "source": "/api/shares", "destination": "/api/assets?share=1" },
    { "source": "/api/shares/:path*", "destination": "/api/assets?sharePath=:path*" },
    { "source": "/api/assets/:path*", "destination": "/api/assets?path=:path*" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co; frame-src 'self'; object-src 'self'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
